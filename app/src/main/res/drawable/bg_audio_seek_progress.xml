<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <size android:height="6dp" />
            <corners android:radius="3dp" />
            <solid android:color="#26282D" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <size android:height="6dp" />
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="#6A4DFF"
                    android:endColor="#B100FF"
                    android:startColor="#11B8FF"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
