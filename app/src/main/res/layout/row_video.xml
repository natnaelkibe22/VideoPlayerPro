<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:minHeight="64dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="Video row item">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:contentDescription="Thumbnail placeholder">

        <TextView
            android:id="@+id/videoThumb"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/videoThumbImage"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Video thumbnail" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/videoSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B8BDC7"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
