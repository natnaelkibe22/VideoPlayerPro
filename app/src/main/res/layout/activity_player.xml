<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:contentDescription="Player screen"
    android:keepScreenOn="true">

    <!-- Fullscreen Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Player video surface"
        app:show_buffering="when_playing"
        app:use_controller="false"
        app:resize_mode="fit" />

    <ImageView
        android:id="@+id/audioArtworkView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Audio artwork background"
        android:background="#FF0A0A0A"
        android:scaleType="centerCrop"
        android:alpha="0.32"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/audioArtworkDeck"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_audio_artwork_ring"
        android:contentDescription="Audio player artwork"
        android:visibility="gone">

        <ImageView
            android:id="@+id/audioArtworkThumb"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_audio_artwork_disc"
            android:clipToOutline="true"
            android:contentDescription="Audio player thumbnail"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </FrameLayout>

    <!-- Error Banner -->
    <TextView
        android:id="@+id/playerErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC8B0000"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Semi-transparent dark overlay for controls -->
    <View
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

    <!-- ===== TOP BAR: Title + Menu ===== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:background="#AA000000"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- Close button (left side) -->
        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:contentDescription="Close player"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/closeButton"
            android:layout_toStartOf="@+id/topSpeedButton"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/topSpeedButton"
            android:layout_alignStart="@id/topSpeedButton"
            android:layout_alignEnd="@id/topSpeedButton"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#BBBBBB"
            android:textSize="9sp"
            android:visibility="visible"
            android:contentDescription="Speed button" />

        <TextView
            android:id="@+id/musicStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/topSpeedButton"
            android:layout_marginEnd="4dp"
            android:text="🎵"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:minWidth="36dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/topSpeedButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/topAudioOnlyButton"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_speed"
            android:contentDescription="Speed"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/topAudioOnlyButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/menuButton"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_music_note"
            android:contentDescription="Play as Music"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu"
            android:scaleType="centerInside" />
    </RelativeLayout>

    <!-- ===== CENTER CONTROLS: Play/Pause + Prev/Next + Seek buttons ===== -->
    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Previous / Play-Pause / Next -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_previous"
                android:contentDescription="Previous"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/centerPlayPause"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="Next"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- 5s back / 15s forward -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/seekBack5"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_replay_5"
                android:contentDescription="Rewind 5 seconds"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/seekForward15"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward_15"
                android:contentDescription="Forward 15 seconds"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== BOTTOM BAR: Seek bar + time + action buttons ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Seek bar + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:max="1000" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Action buttons row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/playlistButton"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_playlist"
                    android:contentDescription="Playlist"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/repeatButton"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_repeat"
                    android:contentDescription="Repeat off"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/floatingButton"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_float"
                    android:contentDescription="Floating player"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Dim overlay behind the playlist drawer -->
    <View
        android:id="@+id/playlistDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Playlist drawer dim overlay"
        android:background="#000000"
        android:visibility="gone" />

    <!-- ===== RIGHT SIDE PLAYLIST DRAWER ===== -->
    <LinearLayout
        android:id="@+id/sidePlaylist"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:contentDescription="Playlist drawer"
        android:layout_gravity="end"
        android:background="#DD101114"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Folder Playlist"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlistCurrentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Current"
            android:textColor="#2F80ED"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
