<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:contentDescription="Player screen"
    android:keepScreenOn="true">

    <!-- Fullscreen Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Player video surface"
        app:show_buffering="when_playing"
        app:use_controller="false"
        app:resize_mode="fit" />

    <ImageView
        android:id="@+id/audioArtworkView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Audio artwork background"
        android:background="#FF0A0A0A"
        android:scaleType="centerCrop"
        android:alpha="0.32"
        android:visibility="gone" />

    <!-- Error Banner -->
    <TextView
        android:id="@+id/playerErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC8B0000"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Transparent tap catcher: sits above playerView but below controls.
         Catches taps that ExoPlayer's PlayerView might otherwise consume. -->
    <View
        android:id="@+id/tapCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Tap to show controls"
        android:visibility="visible" />

    <!-- Semi-transparent dark overlay for controls -->
    <View
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

    <!-- ===== TOP BAR: Title + Menu ===== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_gravity="top"
        android:background="#00000000"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:paddingStart="22dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- Back button (left side) -->
        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:tooltipText="Back"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/closeButton"
            android:layout_toEndOf="@id/closeButton"
            android:layout_toStartOf="@+id/speedLabel"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="normal" />

        <ImageView
            android:id="@+id/folderIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_below="@id/videoTitle"
            android:layout_alignStart="@id/videoTitle"
            android:layout_marginTop="12dp"
            android:contentDescription="Folder"
            android:src="@drawable/ic_folder_outline" />

        <TextView
            android:id="@+id/folderNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/folderIcon"
            android:layout_toEndOf="@id/folderIcon"
            android:layout_toStartOf="@id/speedLabel"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="18dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F6F2FF"
            android:textSize="15sp" />

        <!-- Speed indicator chip: shows current speed, tap/long-press to change -->
        <TextView
            android:id="@+id/speedLabel"
            android:layout_width="58dp"
            android:layout_height="36dp"
            android:layout_alignTop="@id/closeButton"
            android:layout_toStartOf="@+id/musicStatusLabel"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_speed_indicator"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:tooltipText="Playback Speed"
            android:contentDescription="Playback speed" />

        <TextView
            android:id="@+id/musicStatusLabel"
            android:layout_width="58dp"
            android:layout_height="36dp"
            android:layout_alignTop="@id/closeButton"
            android:layout_toStartOf="@+id/topAudioOnlyButton"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_speed_indicator"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/topAudioOnlyButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignTop="@id/closeButton"
            android:layout_toStartOf="@+id/menuButton"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_headphones"
            android:contentDescription="Play as Music"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/closeButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu"
            android:scaleType="centerInside" />
    </RelativeLayout>

    <!-- Audio visual layer: foreground orbit so the background can stay dim without muting the glow. -->
    <ImageView
        android:id="@+id/audioEqualizerRing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:contentDescription="Audio equalizer ring"
        android:visibility="gone" />

    <com.natkibe.videoplayerpro.player.AudioEqualizerView
        android:id="@+id/audioEqualizerBars"
        android:layout_width="286dp"
        android:layout_height="286dp"
        android:layout_gravity="center"
        android:contentDescription="Audio equalizer bars"
        android:translationY="-28dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/audioArtworkDeck"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_audio_artwork_ring"
        android:contentDescription="Audio player artwork"
        android:translationY="-28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/audioArtworkThumb"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_audio_artwork_disc"
            android:clipToOutline="true"
            android:contentDescription="Audio player thumbnail"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </FrameLayout>

    <!-- ===== CENTER CONTROLS: Play/Pause + Prev/Next + Seek buttons ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:translationY="-28dp"
        android:visibility="gone">

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_previous"
                android:contentDescription="Previous"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@id/centerPlayPause"
                app:layout_constraintEnd_toStartOf="@id/centerPlayPause"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintTop_toTopOf="@id/centerPlayPause"
                android:layout_marginEnd="80dp" />

            <ImageButton
                android:id="@+id/centerPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_center_pause_gradient"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause"
                android:elevation="10dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="Next"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="@id/centerPlayPause"
                app:layout_constraintStart_toEndOf="@id/centerPlayPause"
                app:layout_constraintTop_toTopOf="@id/centerPlayPause"
                android:layout_marginStart="80dp" />

            <ImageButton
                android:id="@+id/seekBack5"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_replay_5"
                android:contentDescription="Rewind 5 seconds"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toStartOf="@id/centerPlayPause"
                app:layout_constraintTop_toBottomOf="@id/centerPlayPause"
                android:layout_marginEnd="-4dp"
                android:layout_marginTop="-4dp" />

            <ImageButton
                android:id="@+id/seekForward15"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward_15"
                android:contentDescription="Forward 15 seconds"
                android:scaleType="centerInside"
                app:layout_constraintStart_toEndOf="@id/centerPlayPause"
                app:layout_constraintTop_toBottomOf="@id/centerPlayPause"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="-4dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== BOTTOM BAR: Seek bar + time + action buttons ===== -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_audio_bottom_dock"
        android:elevation="16dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:visibility="gone">

        <!-- Seek preview thumbnail popup (shown during drag) -->
        <FrameLayout
                android:id="@+id/seekPreviewFrame"
            android:layout_width="96dp"
            android:layout_height="60dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-66dp"
            android:background="@drawable/bg_seek_preview"
            android:visibility="gone"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/seekPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Seek preview" />

            <TextView
                android:id="@+id/seekPreviewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="#BB000000"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/repeatButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_repeat"
                    android:contentDescription="Repeat off"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/playlistButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_playlist"
                    android:contentDescription="Playlist"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/floatingButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_float"
                    android:contentDescription="Floating player"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"
                android:background="#33FFFFFF" />

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    android:progressDrawable="@drawable/bg_audio_seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_audio_seek_thumb"
                    android:max="1000" />

                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Dim overlay behind the playlist drawer -->
    <View
        android:id="@+id/playlistDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Playlist drawer dim overlay"
        android:background="#000000"
        android:visibility="gone" />

    <!-- ===== RIGHT SIDE PLAYLIST DRAWER ===== -->
    <LinearLayout
        android:id="@+id/sidePlaylist"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:contentDescription="Playlist drawer"
        android:layout_gravity="end"
        android:background="#DD101114"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Folder Playlist"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlistCurrentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Current"
            android:textColor="#2F80ED"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
