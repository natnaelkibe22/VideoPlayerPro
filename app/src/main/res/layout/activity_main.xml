<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainFolderScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101114"
    android:contentDescription="Main folder screen"
    android:fitsSystemWindows="true"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VideoPlayer Pro"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/topTabBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/videoTab"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab"
            android:clickable="true"
            android:contentDescription="Folders"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Folders"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/recentTab"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab"
            android:clickable="true"
            android:contentDescription="Recent"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Recent"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/storageTab"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab"
            android:clickable="true"
            android:contentDescription="Storage"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Storage"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/settingsTab"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab"
            android:clickable="true"
            android:contentDescription="Settings"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/refreshButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_setting_chip"
            android:clickable="true"
            android:contentDescription="Refresh"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:text="Refresh"
            android:textColor="#B8BDC7"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Cached video folders load first. Refresh runs in background."
        android:textColor="#B8BDC7"
        android:textSize="16sp" />

    <!-- Settings panel (hidden by default, shown when Settings tab is active) -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Settings screen"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="72dp"
            android:paddingBottom="4dp">

            <!-- All 13 settings toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Show Thumbnails" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchThumbnails"
                    android:contentDescription="Thumbnail toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Floating Player" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFloating"
                    android:contentDescription="Floating player setting toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Floating Controls Only" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFloatingControls"
                    android:contentDescription="Floating controls toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Show Playlist While Watching" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPlaylist"
                    android:contentDescription="Playlist drawer setting toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Dark Theme" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDarkTheme"
                    android:contentDescription="Dark theme toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Resume Playback" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchResume"
                    android:contentDescription="Resume playback toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Auto-Play Next" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoplayNext"
                    android:contentDescription="Autoplay next toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Headunit Safe Mode" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSafeMode"
                    android:contentDescription="Safe Mode toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Auto-Hide Controls" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoHideControls"
                    android:contentDescription="Auto-hide controls toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Use Fancy Blur" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFancyBlur"
                    android:contentDescription="Fancy blur toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Compact Playlist Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Compact Playlist Rows" android:textColor="#FFFFFF" android:textSize="14sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCompactPlaylist"
                    android:contentDescription="Compact playlist toggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Accent color (button cycle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Accent Color" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView
                    android:id="@+id/btnAccentColor"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@drawable/bg_setting_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:text="Blue"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Default speed (button cycle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Default Speed" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView
                    android:id="@+id/btnDefaultSpeed"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@drawable/bg_setting_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:text="1.0x"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Default repeat mode (button cycle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Default Repeat Mode" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView
                    android:id="@+id/btnRepeatMode"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@drawable/bg_setting_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:text="Off"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Open Diagnostics button -->
            <Button
                android:id="@+id/openDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Diagnostics"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/settingsTextInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:text="Settings for VideoPlayer Pro"
        android:textColor="#B8BDC7"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
